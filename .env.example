NODE_ENV=development
PORT=3001

# MySQL. Local MySQL 8 without TLS needs allowPublicKeyRetrieval=true.
# Managed MySQL (PlanetScale, TiDB Cloud): append ?sslaccept=strict and drop allowPublicKeyRetrieval.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/social_listening?allowPublicKeyRetrieval=true

# At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=43200

# Browser origins allowed to call the API directly (not needed when the FE proxies /api).
CORS_ORIGINS=http://localhost:3000

# AI through an OpenAI-compatible gateway (9Router, OpenRouter, LiteLLM...). When AI_BASE_URL is set
# it replaces the Gemini settings below. AI_MODEL = the gateway's model or combo name. Every model in
# the combo must support tool/function calling: the assistant reads data only through tools.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODEL=

# Gemini direct (used when AI_BASE_URL is empty). Never commit a real key. Pick a model ID from Google AI Studio that supports function calling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: used for a few minutes when GEMINI_MODEL is overloaded ("high demand")
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Summary report e-mail (SMTP). Gmail/Google Workspace: smtp.gmail.com, 465, SMTP_SECURE=true, app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Creacon Social Listening <report@creacon.id>"
# Dashboard link in e-mails
APP_URL=https://social-listening.creacon.id
# Vercel Cron calls /api/cron/monthly-reports daily with this as a Bearer token (Vercel adds it automatically
# when CRON_SECRET is set in the project). Generate with: openssl rand -hex 24
CRON_SECRET=

# Excel ingestion
UPLOAD_DIR=./uploads
BLOB_HOST_SUFFIX=.blob.vercel-storage.com
# Only for private Blob stores:
BLOB_READ_WRITE_TOKEN=
# Optional override. Defaults to 240000 on Vercel and no limit elsewhere.
# INGESTION_TIME_BUDGET_MS=240000

# Used once by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
